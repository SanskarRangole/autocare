# Supabase Configuration
# Replace these with your Supabase project credentials from Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Set to 'true' to force demo/mock mode even if Supabase keys are provided
# When false (default), AutoCare connects directly to Supabase if valid credentials exist.
# If credentials are not provided or invalid, AutoCare gracefully falls back to interactive Local/Demo storage so you can test all features immediately.
VITE_ENABLE_OFFLINE_DEMO=false
